{
  "name": "skywake",
  "version": "0.1.2",
  "description": "Skywake in one package: the TypeScript SDK, a bash shell for AI agents over a branch, and the skywake command.",
  "keywords": [
    "skywake",
    "cli",
    "sdk",
    "ai-agents",
    "filesystem",
    "s3",
    "copy-on-write",
    "branching",
    "bash",
    "just-bash",
    "ai-sdk",
    "mcp",
    "vector-search",
    "full-text-search",
    "hybrid-search"
  ],
  "homepage": "https://skywake.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skywakehq/skywake.git",
    "directory": "packages/skywake"
  },
  "bugs": "https://github.com/skywakehq/skywake/issues",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./bash": {
      "types": "./dist/bash.d.ts",
      "default": "./dist/bash.js"
    },
    "./ai": {
      "types": "./dist/ai.d.ts",
      "default": "./dist/ai.js"
    }
  },
  "bin": {
    "skywake": "bin/skywake.cjs",
    "skywake-bash-mcp": "dist/mcp.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "@skywake/sdk": "workspace:*",
    "just-bash": "^3.6.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "ai": ">=5"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@skywake/config": "workspace:*",
    "@types/node": "^22",
    "ai": "^6.0.0",
    "typescript": "^5.8.3"
  }
}
