{
  "name": "skywake",
  "version": "0.2.0",
  "description": "Skywake in one package: the open-source search index on object storage, with its TypeScript SDK, the skywake command and an MCP server.",
  "keywords": [
    "skywake",
    "search",
    "search-index",
    "vector-search",
    "full-text-search",
    "hybrid-search",
    "bm25",
    "embeddings",
    "rag",
    "object-storage",
    "sdk",
    "cli",
    "mcp"
  ],
  "homepage": "https://skywake.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skywakehq/skywake.git",
    "directory": "packages/skywake"
  },
  "bugs": "https://github.com/skywakehq/skywake/issues",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "skywake": "bin/skywake.cjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "@skywake/sdk": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@skywake/config": "workspace:*",
    "@types/node": "^22",
    "typescript": "^5.8.3"
  }
}
