# Settings for running the benchmarks on Cloudflare R2. Copy this file to
# benchmarks/cloud/r2/r2.env (git ignores it) and fill it in. In the Cloudflare dashboard:
# R2 > create a bucket, then R2 > Manage API tokens > create a token with
# "Object Read & Write" on that bucket only.
SKYWAKE_STORE=s3://your-bucket
AWS_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=auto
AWS_DEFAULT_REGION=auto
