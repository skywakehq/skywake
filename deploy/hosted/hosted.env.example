# Append to /opt/skywake/.env on the machine, then fill in every value.
# Lines set here replace the ones the stack wrote.

# ── Where people reach it ───────────────────────────────────────────────
CONSOLE_HOST=app.skywake.dev
API_HOST=api.skywake.dev
ZERO_HOST=sync.skywake.dev
CONSOLE_URL=https://app.skywake.dev
API_URL=https://api.skywake.dev
ZERO_URL=https://app.skywake.dev/zero

# ── Neon: the direct host (no -pooler) for every service ────────────────
COMPOSE_PROFILES=
DATABASE_HOST=ep-xxxx.ap-southeast-2.aws.neon.tech
POSTGRES_USER=neondb_owner
POSTGRES_DB=neondb
POSTGRES_PASSWORD=
API_DB_PASSWORD=
CONSOLE_DB_PASSWORD=
ZERO_DB_PASSWORD=
API_DATABASE_URL=postgres://skywake_api:${API_DB_PASSWORD}@${DATABASE_HOST}/neondb?sslmode=require
CONSOLE_DATABASE_URL=postgres://skywake_console:${CONSOLE_DB_PASSWORD}@${DATABASE_HOST}/neondb?sslmode=require
ZERO_DATABASE_URL=postgres://skywake_zero:${ZERO_DB_PASSWORD}@${DATABASE_HOST}/neondb?sslmode=require

# ── Stripe (live account) ───────────────────────────────────────────────
STRIPE_LIVE=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Email and sign-in ───────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=Skywake <hello@skywake.dev>
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Limits ──────────────────────────────────────────────────────────────
MAX_USERS=100
CACHE_GB=40
FILES_MEMORY_MB=2048
SKYWAKE_VERSION=0.3.0
