# Headers for the browser-facing hosts. The API sets its own.
(browser) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options DENY
		Content-Security-Policy "frame-ancestors 'none'"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

{$CONSOLE_HOST} {
	import browser
	# The sync server shares the console's host, so the browser sends it the sign-in cookie.
	handle_path /zero/* {
		reverse_proxy zero:4848
	}
	handle {
		reverse_proxy console:3100
	}
}

{$API_HOST} {
	reverse_proxy api:8080
}

{$ZERO_HOST} {
	import browser
	reverse_proxy zero:4848
}
