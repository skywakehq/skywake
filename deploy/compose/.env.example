# Settings for compose.yaml. Fill in every secret, for example with
#   openssl rand -hex 32

# The release to run. Empty for the one this file came with.
# SKYWAKE_VERSION=
# SKYWAKE_REGISTRY=ghcr.io/skywakehq

# Which bundled services to run: `postgres` and `s3` to try Skywake on this
# machine alone; drop one to use your own database or bucket; add `docs`.
COMPOSE_PROFILES=postgres,s3

# ── Secrets ─────────────────────────────────────────────────────────────
SKYWAKE_API_ADMIN_TOKEN=
BETTER_AUTH_SECRET=
ZERO_ADMIN_PASSWORD=
# The database's owner, and each service's own role in it.
POSTGRES_PASSWORD=
API_DB_PASSWORD=
CONSOLE_DB_PASSWORD=
ZERO_DB_PASSWORD=

# ── Your own Postgres (15 or newer, with logical replication) ───────────
# Without the `postgres` profile. The owner is POSTGRES_USER with
# POSTGRES_PASSWORD; the roles are made on it at every start. On Amazon
# RDS, the Node clients need these TLS settings, in this form:
# DATABASE_HOST=skywake.abc123.us-east-1.rds.amazonaws.com
# POSTGRES_USER=skywake
# API_DATABASE_URL=postgres://skywake_api:<API_DB_PASSWORD>@<host>/skywake?sslmode=no-verify
# CONSOLE_DATABASE_URL=postgres://skywake_console:<CONSOLE_DB_PASSWORD>@<host>/skywake?sslmode=no-verify
# ZERO_DATABASE_URL=postgres://skywake_zero:<ZERO_DB_PASSWORD>@<host>/skywake?sslmode=require

# ── The bucket ──────────────────────────────────────────────────────────
# With the `s3` profile these keys are the bundled server's own. For your
# own bucket: SKYWAKE_STORE=s3://bucket and its endpoint, such as
# https://s3.us-east-1.amazonaws.com. On EC2 with an instance role, delete
# the two key lines entirely (an empty value is not the same as none).
SKYWAKE_STORE=s3://skywake
AWS_REGION=us-east-1
AWS_ENDPOINT=http://s3:9000
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Where people reach it ───────────────────────────────────────────────
CONSOLE_URL=http://localhost:3100
API_URL=http://localhost:8080
ZERO_URL=http://localhost:4848
# Behind a proxy or load balancer, its addresses (see the IP allowlist docs).
# TRUSTED_PROXIES=
