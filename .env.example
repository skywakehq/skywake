# Skywake's settings: the only env file, at the repository's root.
# `scripts/setup.sh` copies this to .env and fills in every secret.
# Both `docker compose up` (self-hosting) and `pnpm dev` (development) read it.
# The schemas each service checks are in packages/env.

# ── Secrets ─────────────────────────────────────────────────────────────
# Creates organizations through the API. At least 16 characters.
SKYWAKE_API_ADMIN_TOKEN=
# Signs the console's sessions. At least 32 characters.
BETTER_AUTH_SECRET=
# Postgres, and each service's own role in it.
POSTGRES_PASSWORD=
API_DB_PASSWORD=
CONSOLE_DB_PASSWORD=
ZERO_DB_PASSWORD=
# zero-cache's admin pages.
ZERO_ADMIN_PASSWORD=

# ── The bucket ──────────────────────────────────────────────────────────
# Empty: the bundled S3 server, with these keys as its own.
# Your own bucket: s3://bucket, its keys, and its endpoint, such as
# https://s3.us-east-1.amazonaws.com or https://<account>.r2.cloudflarestorage.com
SKYWAKE_STORE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT=
AWS_REGION=us-east-1

# ── Where people reach it ───────────────────────────────────────────────
# Change these when it runs on a server, behind HTTPS.
CONSOLE_URL=http://localhost:3100
API_URL=http://localhost:8080
ZERO_URL=http://localhost:4848
# CONSOLE_PORT=3100
# API_PORT=8080
# ZERO_PORT=4848
# Serve the console at a path, behind a proxy: /dashboard
# CONSOLE_BASE_PATH=

# ── Optional ────────────────────────────────────────────────────────────
# An OpenAI-style embeddings API and a Cohere-style rerank API, to give
# vectors as text and to rerank hits.
# SKYWAKE_API_EMBED_URL=
# SKYWAKE_API_EMBED_KEY=
# SKYWAKE_API_RERANK_URL=
# SKYWAKE_API_RERANK_KEY=

# Credentials limited to one namespace: an IAM role the API may assume, and
# for an S3-compatible store, its STS endpoint.
# SKYWAKE_API_STS_ROLE_ARN=
# SKYWAKE_API_STS_ENDPOINT=

# Single sign-on. Identity providers on a private network (a local Keycloak)
# must be listed by origin. Domains listed in SSO_VERIFIED_DOMAINS need no
# DNS record to prove: only for domains you, the operator, own.
# SSO_PRIVATE_IDP_ORIGINS=
# SSO_VERIFIED_DOMAINS=

# The console takes a person's address from its own connection, for the IP
# allowlist and the audit log. Behind a proxy or load balancer, list its
# addresses or CIDRs here; only then are X-Forwarded-For and X-Real-IP read.
# TRUSTED_PROXIES=10.0.0.0/8

# Billing with Stripe, for a hosted service. Off without a key.
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
# SKYWAKE_API_CONSOLE_URL=

# ── Hosted service ──────────────────────────────────────────────────────
# Only for running Skywake as a service for others. Self-hosted installs
# leave all of these empty and the console stays as it is.
#
# Email: verification on sign-up, password reset and invites by email. On
# when RESEND_API_KEY or SMTP_URL is set; Resend wins when both are.
# RESEND_API_KEY=
# SMTP_URL=smtp://user:password@smtp.example.com:587
# EMAIL_FROM=Skywake <hello@example.com>
#
# Sign in with Google or GitHub. Each is on when its id and secret are set.
# Callback URLs: <CONSOLE_URL>/api/auth/callback/google and .../github
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
#
# The Cloud waitlist on the marketing site (apps/www): a Postgres URL. The
# site makes its own site.waitlist table there and sends each new sign-up
# one email, when email is on. Off while empty.
# WAITLIST_DATABASE=postgres://user:password@localhost:5432/skywake
#
# Skywake Cloud on the marketing site: `1` links its buttons to the console
# instead of the waitlist. Off while empty.
# CLOUD_OPEN=

# The docs, with `docker compose --profile docs up -d`.
# DOCS_PORT=3200
# DOCS_BASE_PATH=
