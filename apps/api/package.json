{
  "name": "@skywake/api",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "The Skywake API server: the contract, served by Hono on Node, over the engine and Postgres.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/main.ts",
    "test": "node --test --test-concurrency=1 \"test/*.test.ts\"",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-sts": "^3.1164.0",
    "@hono/node-server": "^2.1.6",
    "@hono/zod-openapi": "^1.6.3",
    "@skywake/contract": "workspace:*",
    "@skywake/engine": "workspace:*",
    "@skywake/env": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "jose": "^6.2.15",
    "pg": "^8.23.1",
    "prom-client": "^15.1.3",
    "stripe": "23.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@skywake/config": "workspace:*",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.3"
  }
}
