{
  "$schema": "https://turborepo.com/schema.json",
  "envMode": "loose",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": [
        "DOCS_URL",
        "DOCS_LINK",
        "DOCS_BASE_PATH",
        "DOCS_ASSET_PREFIX",
        "CONSOLE_URL",
        "CONSOLE_LINK",
        "CONSOLE_BASE_PATH",
        "SITE_URL",
        "CLOUD_OPEN"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "e2e": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
