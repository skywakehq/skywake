{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-component-in-tag": false,
  "packages": {
    ".": {
      "release-type": "simple",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        { "type": "toml", "path": "Cargo.toml", "jsonpath": "$.workspace.package.version" },
        { "type": "toml", "path": "sdks/python/pyproject.toml", "jsonpath": "$.project.version" },
        { "type": "json", "path": "sdks/typescript/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "packages/skywake-cli/package.json", "jsonpath": "$.version" },
        {
          "type": "json",
          "path": "packages/skywake-cli/package.json",
          "jsonpath": "$.optionalDependencies['@skywake/cli-linux-x64']"
        },
        {
          "type": "json",
          "path": "packages/skywake-cli/package.json",
          "jsonpath": "$.optionalDependencies['@skywake/cli-linux-arm64']"
        },
        {
          "type": "json",
          "path": "packages/skywake-cli/npm/linux-x64/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/skywake-cli/npm/linux-arm64/package.json",
          "jsonpath": "$.version"
        },
        { "type": "yaml", "path": "deploy/helm/skywake/Chart.yaml", "jsonpath": "$.version" },
        { "type": "yaml", "path": "deploy/helm/skywake/Chart.yaml", "jsonpath": "$.appVersion" },
        { "type": "pom", "path": "sdks/java/pom.xml" },
        {
          "type": "xml",
          "path": "sdks/csharp/src/Skywake/Skywake.csproj",
          "xpath": "//Project/PropertyGroup/Version"
        }
      ]
    }
  }
}
