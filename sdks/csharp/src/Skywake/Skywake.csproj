<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Skywake</RootNamespace>
    <PackageId>Skywake</PackageId>
    <Version>0.4.2</Version>
    <Authors>Skywake</Authors>
    <Description>Skywake for .NET: shared, branchable disks with search, for AI agents.</Description>
    <PackageTags>skywake;vector-search;full-text-search;branches;files;rag;ai-agents</PackageTags>
    <PackageProjectUrl>https://skywake.dev</PackageProjectUrl>
    <RepositoryUrl>https://github.com/skywakehq/skywake</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
